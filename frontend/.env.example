# ── EtherSignals environment template (copy to .env) ─────────────────

# PostgreSQL connection string (required) — e.g. the BaoTa-managed instance:
DATABASE_URL="postgresql://ether:ether@127.0.0.1:5432/ethersignals"

# Public base URL of the site (metadata / manifest / OG / sitemap).
# Baked in at BUILD time — after changing it, rebuild the image:
#   docker compose -f docker-compose.prod.yml up -d --build
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Webhook auth token(s) for the GTrading signal.trend ingest endpoint.
# GTrading sends it as `Authorization: Bearer <token>`; comma-separated for
# zero-downtime rotation. Generate: openssl rand -hex 32
WEBHOOK_SECRETS=""

# Optional tolerance window for webhook timestamps, seconds (default 300)
# WEBHOOK_TIMESTAMP_TOLERANCE="300"

# Telegram channel invite (shown in header / footer / mobile drawer)
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/EtherSignals"

# Self-hosted Umami analytics (optional; loaded only after "Accept all").
# Defaults to the EtherSignals instance below.
# NEXT_PUBLIC_UMAMI_URL="https://stats.cuishushu.com/script.js"
# NEXT_PUBLIC_UMAMI_SITE_ID="eb3e811b-f3c8-4af3-802d-8d8991f2238d"

# GitHub repository showcased with its star count (owner/name).
# Set GITHUB_TOKEN only if the repo is private (classic PAT, public_repo scope).
NEXT_PUBLIC_GITHUB_REPO="Travisun/EtherSignals"
# GITHUB_TOKEN=""

# Web Push (optional — notifications degrade gracefully when unset)
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.com"

# Set "false" only when NOT behind a reverse proxy; controls whether
# X-Forwarded-For is trusted for client-IP based rate limiting.
TRUST_PROXY="true"
