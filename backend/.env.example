# GTrading server configuration
# All exchange API keys / SMTP / LLM keys are configured inside the app (Settings UI)
# and stored locally under ./data — no secrets belong in this file.

# HTTP port for the custom server (default 3000)
PORT=3000

# Data directory for local persistence (default ./data)
# DATA_DIR=./data

# Exchange egress proxy (Clash / V2Ray …). Node's fetch does NOT honor OS proxy
# settings, so in restricted regions point the server at your local proxy port.
# Find the real port with `scutil --proxy` (Clash Verge defaults to 7897).
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1
